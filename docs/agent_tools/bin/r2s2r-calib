#!/bin/bash
# Sim-to-target calibration helpers (optional, local): extract, replay, compare, video, record. Nothing is sent anywhere.
PY="${R2S2R_PYTHON:-}"
[ -z "$PY" ] && [ -x "$HOME/.cache/venvs/torch-cuda/bin/python" ] && PY="$HOME/.cache/venvs/torch-cuda/bin/python"
[ -z "$PY" ] && [ -x /opt/r2s2r/policy-check-venv/bin/python ] && PY=/opt/r2s2r/policy-check-venv/bin/python
exec "${PY:-python3}" /usr/local/lib/r2s2r/tools/calib.py "$@"
