#!/bin/bash
# Check a joint trajectory against the Wuji Hand 2 hardware rules (hardware/SPECS.md section 6). Local only: nothing is sent anywhere.
PY="${R2S2R_PYTHON:-}"
[ -z "$PY" ] && [ -x "$HOME/.cache/venvs/torch-cuda/bin/python" ] && PY="$HOME/.cache/venvs/torch-cuda/bin/python"
exec "${PY:-python3}" /usr/local/lib/r2s2r/hwcheck/hwcheck.py --spec /usr/local/lib/r2s2r/hwcheck/hardware_spec.json "$@"
