#!/bin/bash
# Local pre-check of a policy package for the target environment (see /usr/local/lib/r2s2r/preflight.py). Nothing is sent anywhere.
PY="${R2S2R_PYTHON:-}"
# default: the CPU policy-validation environment that matches the target runtime (Python 3.12, NumPy 2.5.4, PyTorch 2.14.1 CPU)
[ -z "$PY" ] && [ -x /opt/r2s2r/policy-check-venv/bin/python ] && PY=/opt/r2s2r/policy-check-venv/bin/python
[ -z "$PY" ] && [ -x "$HOME/.cache/venvs/torch-cuda/bin/python" ] && PY="$HOME/.cache/venvs/torch-cuda/bin/python"
exec "${PY:-python3}" /usr/local/lib/r2s2r/preflight.py "$@"
